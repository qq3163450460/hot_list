# Shared HTTP behavior
HOT_LIST_REQUEST_TIMEOUT_SECONDS=10.0
HOT_LIST_MAX_RETRIES=3
HOT_LIST_RETRY_MIN_WAIT_SECONDS=0.2
HOT_LIST_RETRY_MAX_WAIT_SECONDS=2.0
HOT_LIST_REQUESTS_PER_SECOND=2.0
HOT_LIST_USER_AGENT=hot-list/0.1 (+https://localhost)
HOT_LIST_LOG_LEVEL=INFO
# Enable FastAPI debug mode for local development; keep false in production.
HOT_LIST_DEBUG=false

# Database and hourly history collection
# Docker Compose overrides this with the persistent container path shown below.
HOT_LIST_DATABASE_URL=sqlite+aiosqlite:////app/data/hot_list.db
HOT_LIST_APP_TIMEZONE=Asia/Shanghai
HOT_LIST_SCHEDULER_ENABLED=true
HOT_LIST_COLLECT_ON_STARTUP=true
HOT_LIST_COLLECT_CRON_MINUTE=0

# Optional MySQL deployment. Keep real credentials only in .env and never commit them.
# MYSQL_DATABASE=hot_list
# MYSQL_USER=hot_list
# MYSQL_PASSWORD=replace-with-a-strong-password
# MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
# HOT_LIST_DATABASE_URL=mysql+asyncmy://hot_list:replace-with-a-strong-password@mysql:3306/hot_list?charset=utf8mb4

# Candidate platform endpoints below remain UNVERIFIED.
# See reverse-records/请求链路.md before using them against real platforms.

# Weibo
HOT_LIST_WEIBO_ENABLED=true
HOT_LIST_WEIBO_ENDPOINT=https://weibo.com/ajax/side/hotSearch
# Keep real cookies only in .env; never commit them.
HOT_LIST_WEIBO_COOKIE=

# Bilibili
HOT_LIST_BILIBILI_ENABLED=true
HOT_LIST_BILIBILI_ENDPOINT=https://api.bilibili.com/x/web-interface/search/square
# Keep real cookies only in .env; never commit them.
HOT_LIST_BILIBILI_COOKIE=

# Zhihu
HOT_LIST_ZHIHU_ENABLED=true
HOT_LIST_ZHIHU_ENDPOINT=https://www.zhihu.com/api/v4/search/hot_search
# Keep real cookies only in .env; never commit them.
HOT_LIST_ZHIHU_COOKIE=
